{
  "name": "wispr-voice",
  "productName": "Wispr Voice",
  "description": "Fast, privacy-first voice dictation for Windows. Bring your own API key.",
  "author": "Wispr Voice contributors",
  "license": "MIT",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "cross-env NODE_OPTIONS=--use-system-ca vite build && cross-env NODE_OPTIONS=--use-system-ca electron-builder",
    "package:win": "cross-env NODE_OPTIONS=--use-system-ca electron-builder --win nsis --publish never",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.wisprvoice.app",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "dir"
      ],
      "icon": "public/icon.ico",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "directories": {
      "output": "dist-app"
    }
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "wait-on": "^9.1.0"
  }
}
